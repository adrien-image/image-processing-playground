{
  "name": "image-processing-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare-data": "node scripts/build-mnist-sprite.mjs",
    "predev": "npm run prepare-data",
    "dev": "vite",
    "prebuild": "npm run prepare-data",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tensorflow/tfjs": "^4.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "mnist": "^1.1.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.4"
  }
}
